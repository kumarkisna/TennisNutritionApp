{
  "expo": {
    "name": "Clear Access — Mobile Food Planner",
    "slug": "clear-access-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clear-access-mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": { "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"] },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      ["expo-camera", { "cameraPermission": "Allow Clear Access to scan food barcodes." }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
